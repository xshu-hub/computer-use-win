{
  "name": "windows-computer-use-mcp",
  "version": "0.1.1",
  "description": "Windows desktop and browser automation for MCP agents over stdio",
  "type": "module",
  "bin": {
    "wcu-mcp": "mcp/server.mjs"
  },
